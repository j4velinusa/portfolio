# Copy to .env.local for development. Never commit the filled-in file.
# On Vercel these live in Project Settings → Environment Variables.
#
# Nothing here has a safe default except GITHUB_REPO / GITHUB_BRANCH / SITE_ORIGIN,
# and those defaults are a footgun worth knowing about: a preview deployment with
# GITHUB_TOKEN set but GITHUB_REPO unset will commit to the production repo.


# --- admin panel (/admin) ---------------------------------------------------

# The single admin password. There is no user table.
ADMIN_PASSWORD=

# Signs every session cookie, magic link and admin token. NOT a password:
# a token is <payload>.HMAC(key, payload) and the payload travels in plaintext,
# so one leaked cookie is a matched (message, MAC) pair. A human-chosen secret
# would be crackable offline from it; a full-entropy one is worthless.
# Must be at least 32 characters. Generate with:
#   openssl rand -base64 32
SESSION_SECRET=

# Rejects cross-site writes to the admin API. Defaults to https://doganaykac.com,
# so set it to http://localhost:3000 when developing.
SITE_ORIGIN=


# --- publishing (posts + course data commit to git) -------------------------

# Fine-grained PAT with contents:write on the repo below. The admin panel
# commits through the GitHub Contents API; nothing is written to local disk.
GITHUB_TOKEN=
GITHUB_REPO=j4velinusa/portfolio
GITHUB_BRANCH=main


# --- media library ----------------------------------------------------------

# Vercel Blob, store access mode "public". Images render through next/image,
# so the store hostname must also appear in images.remotePatterns in
# next.config.ts — the two are one decision.
BLOB_READ_WRITE_TOKEN=


# --- course subscribers -----------------------------------------------------

# Neon Postgres — the string from the console's Connect dialog, for the
# serverless driver. Queries go over HTTP rather than a TCP pool, so there is
# no pooler to run and no connection management on our side.
# Schema lives in db/schema.sql and is applied once by hand.
DATABASE_URL=

# Resend, for magic-link emails. The From address must be on a verified domain.
RESEND_API_KEY=
RESEND_FROM="Riviera Aesthetic <merhaba@doganaykac.com>"


# --- course video (not wired up yet) ----------------------------------------

# Bunny Stream. The security key signs playback tokens and must never reach the
# browser: tokens are minted server-side, after the entitlement check.
BUNNY_LIBRARY_ID=
BUNNY_TOKEN_SECURITY_KEY=
